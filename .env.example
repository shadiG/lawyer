# ---------------------------------------------------------------------------
# Développement : copiez ce fichier en `.env` (ignoré par git).
# Production : définissez ces variables dans Coolify (voir docs/ops/vps.md).
# ---------------------------------------------------------------------------

# Adresse publique du site. FIGÉE AU BUILD (cocher « Build Variable » dans Coolify).
NEXT_PUBLIC_SITE_URL=https://lawyer.shadgramers.com
# Autres adresses d'accès à l'admin (ex. www), séparées par des virgules. Exécution.
ADMIN_ALLOWED_ORIGINS=

# Administration — OBLIGATOIRE en production.
# Secret de signature des sessions : au moins 32 caractères. `openssl rand -hex 32`
PAYLOAD_SECRET=
# Premier compte administrateur, créé au démarrage s'il n'existe aucun utilisateur.
ADMIN_EMAIL=avocat@exemple.fr
ADMIN_PASSWORD=

# Stockage (en Docker : /data, volume persistant, déjà configuré dans l'image).
DATABASE_URI=file:./data/payload.db
MEDIA_DIR=./data/media

# Notification par e-mail des demandes de rendez-vous (facultatif : les demandes
# sont de toute façon enregistrées et visibles dans l'administration).
RESEND_API_KEY=
BOOKING_TO_EMAIL=avocat@exemple.fr
BOOKING_FROM_EMAIL="Cabinet <rendez-vous@votre-domaine.fr>"

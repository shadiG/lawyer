# Adresse publique du site (variable de BUILD dans Coolify).
NEXT_PUBLIC_SITE_URL=https://lawyer.shadgramers.com

# Envoi des demandes de rendez-vous (variables d'EXÉCUTION dans Coolify).
# Sans elles : en développement la demande s'affiche dans la console ;
# en production le formulaire renvoie un message invitant à téléphoner.
RESEND_API_KEY=
BOOKING_TO_EMAIL=avocat@exemple.fr
# Expéditeur sur un domaine vérifié chez Resend.
BOOKING_FROM_EMAIL="Cabinet <rendez-vous@votre-domaine.fr>"
